# Gere segredos diferentes para cada ambiente: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-unique-64-character-hex-secret
POSTGRES_PASSWORD=replace-with-a-different-64-character-hex-password

# Em produção, informe o domínio sem protocolo; separe vários hosts por vírgula.
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:8000
APP_PORT=8000

# Opcional: configure os serviços de e-mail para convite e recuperação de senha.
USE_BREVO=False
BREVO_API_KEY=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SISGEP <sisgepgestao@gmail.com>

# Opcional: habilite o armazenamento de mídia no Cloudinary em vez do volume local.
USE_CLOUDINARY=False
CLOUDINARY_URL=
