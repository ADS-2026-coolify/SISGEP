# Copie este arquivo para ".env" (na raiz de SISGEP.api) e preencha com valores reais.
# NUNCA versione o arquivo ".env" de verdade — apenas este exemplo.

# Gere uma nova chave em produção: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=troque-esta-chave-por-uma-gerada-com-secrets-token-urlsafe

# True apenas em desenvolvimento local
DEBUG=True

# Hosts que o Django aceita servir (separados por vírgula), ex.:
# ALLOWED_HOSTS=sisgep-api.onrender.com,localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# Connection string do Neon (Render > Environment). Formato:
# DATABASE_URL=postgresql://usuario:senha@ep-xxxxx.neon.tech/sisgep?sslmode=require
# Se omitida, o projeto usa SQLite local automaticamente.
DATABASE_URL=

# Origens autorizadas a chamar a API (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=https://sisgep-web.onrender.com

# URL pública do frontend (usada no link de definição/recuperação de senha por e-mail)
FRONTEND_URL=http://localhost:5173

# E-mail (SMTP) — gere uma nova "senha de app" no Google e rotacione a antiga
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=sisgepgestao@gmail.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SISGEP <sisgepgestao@gmail.com>

# Storage externo (Cloudinary) para fotos/documentos — necessário em produção,
# pois o disco do Render é efêmero. Deixe USE_CLOUDINARY=False em dev local.
# Copie o valor "CLOUDINARY_URL" pronto do painel do Cloudinary (Dashboard > API Environment variable).
USE_CLOUDINARY=False
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Envio de e-mail via API HTTPS (Brevo) em vez de SMTP — recomendado em produção,
# pois vários provedores de hospedagem (Render incluso) bloqueiam as portas SMTP.
# Crie uma conta grátis em https://www.brevo.com, verifique um remetente (Senders)
# e gere uma chave em SMTP & API > API Keys.
USE_BREVO=False
BREVO_API_KEY=
